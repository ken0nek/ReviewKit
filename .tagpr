# config file for the tagpr in git config format
# The tagpr generates the initial configuration, which you can rewrite to suit your environment.
# CONFIGURATIONS:
#   tagpr.releaseBranch
#       Generally, it is "main." It is the branch for releases. The tagpr tracks this branch,
#       creates or updates a pull request as a release candidate, or tags when they are merged.
#
#   tagpr.versionFile
#       "-" means no version file: the version lives only in git tags. The README's install
#       snippet pins a major-version lower bound (`from: "1.0.0"`), which is deliberately not
#       bumped on every release.
#
#   tagpr.vPrefix
#       Tags are bare semver (`1.0.0`, not `v1.0.0`), as SwiftPM consumers expect.
#
#   tagpr.release
#       GitHub Release creation behavior after tagging [true, draft, false]
#
#   tagpr.majorLabels / tagpr.minorLabels
#       Label the release PR (or a merged PR) `tagpr:major` or `tagpr:minor` to bump those
#       components. Without a label, the bump is a patch.
[tagpr]
	vPrefix = false
	releaseBranch = main
	versionFile = -
	release = true
